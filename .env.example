# Google Gemini API Key (required)
GOOGLE_API_KEY=your_gemini_api_key_here

# data.gov.in API Key (required for live prices)
DATA_GOV_API_KEY=your_data_gov_in_api_key_here

# Razorpay Test Mode Keys (optional — payment features disabled without these)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret_here

# Razorpay Webhook Secret (optional — for payment confirmations)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
